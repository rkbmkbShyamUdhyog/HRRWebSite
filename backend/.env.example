# Copy to .env and fill in. Never commit .env. On Render, add these under Environment instead.

# Port to listen on. Leave empty locally (defaults to 5000); Render sets it automatically.
PORT=

# Supabase project URL, e.g. https://<project>.supabase.co (Project Settings -> API).
SUPABASE_URL=
# Supabase secret key (sb_secret_...). Server only; never put it in frontend code.
SUPABASE_SECRET_KEY=

# Browser origins allowed to call the API, comma-separated (empty = http://localhost:5173 only).
FRONTEND_URL=

# How form emails are sent: smtp (Gmail, default, for local use) or resend (needed on Render's free plan).
EMAIL_PROVIDER=
# Where contact messages and newsletter sign-ups are delivered (empty = shyamudhyog@gmail.com).
CONTACT_TO=

# SMTP server for EMAIL_PROVIDER=smtp, e.g. smtp.gmail.com.
SMTP_HOST=
# SMTP port: 465 (SSL) or 587 (empty = 465).
SMTP_PORT=
# Gmail address the emails are sent from.
SMTP_USER=
# Gmail App Password (https://myaccount.google.com/apppasswords), 16 characters without spaces.
SMTP_PASS=

# Resend API key (re_...) for EMAIL_PROVIDER=resend, from https://resend.com/api-keys.
RESEND_API_KEY=
# Sender for EMAIL_PROVIDER=resend (empty = HRR Website <onboarding@resend.dev>).
EMAIL_FROM=

# Password for the daily visitor email trigger (POST /api/visits/report). Any long random string;
# put the same value in the GitHub repository secret REPORT_SECRET. Empty = the report is disabled.
REPORT_SECRET=
