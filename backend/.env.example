PORT=5000

# Contact form email (Gmail: turn on 2-Step Verification, then create an App Password
# at https://myaccount.google.com/apppasswords and paste it as SMTP_PASS, without spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-character-app-password
# Where contact form messages and newsletter sign-ups are delivered (defaults to shyamudhyog@gmail.com).
CONTACT_TO=shyamudhyog@gmail.com
